{
  "name": "apis",
  "version": "1.0.0",
  "description": "Enterprise Node.js REST API with Sequelize ORM, JWT Auth, SQLite, Migrations & CRUD",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true
  },
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "sqlite",
    "jwt",
    "rest-api",
    "crud",
    "migrations"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.0.0",
    "jsonwebtoken": "^9.0.0",
    "sequelize": "^6.35.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "sequelize-cli": "^6.6.0",
    "supertest": "^6.3.3"
  }
}
